# ~/.gitconfig.local on an Ubuntu workstation (full profile): GitHub is
# reached over SSH, like on macOS, so pushes use the machine's SSH key.
# Commits are not signed here: signing is a macOS-only setting
# (platform/macos/.gitconfig.macos), so no Linux box needs the signing key.
# The minimal profile does not link this file at all.
[url "git@github.com:"]
  insteadOf = https://github.com/
