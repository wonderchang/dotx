# macOS-specific bash configuration

# ============================================================================
# Environment Variables
# ============================================================================

# Trash directory for safe delete
export TRASH_DIR="$HOME/.Trash"

# ============================================================================
# Homebrew
# ============================================================================

# Initialize Homebrew environment (/opt/homebrew on Apple Silicon,
# /usr/local on Intel). Only once: `brew shellenv` has no duplicate guard,
# so nested shells (tmux, `bash` inside bash) inherit it instead of
# prepending /opt/homebrew/bin to PATH again.
if [ -z "${HOMEBREW_PREFIX:-}" ]; then
  for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    if [ -x "$brew_bin" ]; then
      eval "$("$brew_bin" shellenv)"
      break
    fi
  done
  unset brew_bin
fi

# ============================================================================
# Aliases
# ============================================================================

alias td='open -a TextEdit'

# ============================================================================
# Google Cloud CLI (Homebrew cask gcloud-cli)
# ============================================================================

# gcloud/gsutil/bq are linked into Homebrew's bin already; components added
# later with `gcloud components install` land in the SDK's own bin
if [ -n "${HOMEBREW_PREFIX:-}" ] && [ -d "$HOMEBREW_PREFIX/share/google-cloud-sdk/bin" ] \
   && [[ ":$PATH:" != *":$HOMEBREW_PREFIX/share/google-cloud-sdk/bin:"* ]]; then
  export PATH="$PATH:$HOMEBREW_PREFIX/share/google-cloud-sdk/bin"
fi

# .bashrc does not load bash-completion, so source gcloud's completion directly
if [ -n "${HOMEBREW_PREFIX:-}" ] && [ -f "$HOMEBREW_PREFIX/etc/bash_completion.d/google-cloud-sdk" ]; then
  source "$HOMEBREW_PREFIX/etc/bash_completion.d/google-cloud-sdk"
fi
