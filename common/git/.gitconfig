[alias]
  st = status
  br = branch
  co = checkout
  ci = commit
  d  = difftool
  gr = log \
    --date=short \
    --graph \
    --pretty=format:'%C(yellow)%h%Creset %ad %C(bold green)%an%Creset %s%C(yellow)%d%Creset'
[color]
  ui = true
[diff]
  tool = vimdiff
[difftool]
  prompt = false
[core]
  editor = vim
[merge]
  tool = vimdiff
[url "https://"]
  insteadOf = git://
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  required = true
  process = git-lfs filter-process
[user]
  name = Wonder Chang
  email = iwonder.tw@gmail.com

[gpg]
  format = ssh

[gpg "ssh"]
  allowedSignersFile = ~/.ssh/allowed_signers

# Machine-specific settings (commit signing key, credential helper, SSH
# rewrite of GitHub URLs) live in ~/.gitconfig.local, which dotx links from
# platform/<os>/.gitconfig.<os> in the full profile. The minimal profile
# (servers, containers, WSL) links nothing, so commits work without a signing
# key and clones stay on HTTPS. git ignores a missing include.
[include]
  path = ~/.gitconfig.local
